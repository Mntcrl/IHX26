pragma circom 2.2.2;

include "../../components/geometry/gadgets.circom";
include "../../components/geometry/policy_v1m.circom";

template GeometryGadgetTest() {
    signal input x;
    signal input y;
    signal input den;
    signal input enabled;
    signal input sel[2];
    signal input values[4];
    signal output absolute;
    signal output negative;
    signal output less;
    signal output inside;
    signal output q;
    signal output rem;
    signal output scaled;
    signal output max;
    signal output first;
    signal output picked;
    signal output both;
    signal output either;
    signal output count;
    signal output band0;
    signal output band7;
    signal output band8;
    signal output absLe;
    signal output absGe;
    component a = GeoAbs(8);
    band0 <== GeoInterval(8,0)(x);
    band7 <== GeoInterval(8,7)(x);
    band8 <== GeoInterval(8,8)(x);
    absLe <== GeoAbsLe(9)(x,16);
    absGe <== GeoAbsGe(9)(x,16);
    absolute <== a.out;
    negative <== a.neg;
    less <== GeoLT(9)(x,y);
    inside <== GeoInterval(8,4)(x);
    scaled <== GeoShiftFloor(8,3)(x);
    component gate = GeoSafeDen();
    gate.enabled <== enabled;
    gate.num <== x;
    gate.den <== den;
    component div = GeoFloor(8,8);
    div.num <== gate.safeNum;
    div.den <== gate.safeDen;
    q <== div.q;
    rem <== div.r;
    component best = GeoFirstMax(4,8);
    best.in <== values;
    max <== best.max;
    first <== best.index;
    signal choices[4][1];
    for (var i = 0; i < 4; i++) choices[i][0] <== values[i];
    signal selected[1] <== GeoMux(2,1)(sel,choices);
    picked <== selected[0];
    component bools[3];
    for (var i = 0; i < 3; i++) bools[i] = GeoBool();
    bools[0].in <== enabled;
    bools[1].in <== sel[0];
    bools[2].in <== sel[1];
    both <== GeoAll(3)([enabled,sel[0],sel[1]]);
    either <== GeoAny(3)([enabled,sel[0],sel[1]]);
    count <== GeoCount(3)([enabled,sel[0],sel[1]]);
}

component main = GeometryGadgetTest();
